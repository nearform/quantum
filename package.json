{
  "name": "@nearform/quantum",
  "version": "1.5.0",
  "description": "Component library based on the Quantum Design System",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tailwind-plugin": {
      "import": "./dist/tailwind-plugin.mjs",
      "require": "./dist/tailwind-plugin.js"
    },
    "./global.css": "./dist/global.css"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build:theme": "node scripts/build-theme-css.mjs",
    "prepack": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearform/quantum.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nearform/quantum/issues"
  },
  "homepage": "https://github.com/nearform/quantum#readme",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "overrides": {
    "@swc/core": "^1.13.20",
    "uuid": "^11.1.1",
    "tsup": {
      "esbuild": "^0.28.2"
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
