    "storybook": "^10.6.0",
    "storybook-dark-mode": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.13",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
