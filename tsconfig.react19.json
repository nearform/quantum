{
  // `peerDependencies` allows `react@^18.2.0 || ^19`, but only one `@types/react`
  // can sit in the tree, and it has to be the 18 line: `npm run build` emits
  // dist/index.d.ts from those types, so the published declarations must be
  // valid for a consumer on the support floor. That leaves the other half of the
  // peer range unchecked. This config closes it by type-checking the same
  // sources a second time against the React 19 types.
  //
  // The 19 types are installed out of tree into `.react19-types/` (see the
  // `typecheck:react19` script) rather than declared as npm aliases: an aliased
  // `@types/react-dom@19` carries a hard `peer @types/react@">=19"` that
  // conflicts with the declared `^18.3`, and every `npm install` -- including
  // dependabot's -- would then need `--legacy-peer-deps`. Keeping them out of
  // the root graph costs one extra install step and no resolution hazard.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Without this, `node_modules/@types/react` is still auto-included as a
    // global alongside the mapped 19 types. `skipLibCheck` hides the resulting
    // duplicate declarations, so the run goes green while checking a blend of
    // both majors -- which is the exact failure this config exists to avoid.
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./.react19-types/node_modules/@types/react"],
      "react/*": ["./.react19-types/node_modules/@types/react/*"],
      "react-dom": ["./.react19-types/node_modules/@types/react-dom"],
      "react-dom/*": ["./.react19-types/node_modules/@types/react-dom/*"]
    }
  }
}
